            "values": [
              "\"controller\":\n  \"affinity\":\n    \"podAntiAffinity\":\n      \"requiredDuringSchedulingIgnoredDuringExecution\":\n      - \"labelSelector\":\n          \"matchLabels\":\n            \"app.kubernetes.io/component\": \"controller\"\n            \"app.kubernetes.io/instance\": \"ingress-nginx\"\n            \"app.kubernetes.io/name\": \"ingress-nginx\"\n        \"topologyKey\": \"kubernetes.io/hostname\"\n  \"autoscaling\":\n    \"enabled\": true\n    \"maxReplicas\": 10\n    \"minReplicas\": 2\n    \"targetCPUUtilizationPercentage\": 70\n    \"targetMemoryUtilizationPercentage\": 70\n  \"config\":\n    \"enable-real-ip\": \"true\"\n    \"keep-alive\": \"75\"\n    \"keep-alive-requests\": \"1000\"\n    \"log-format-escape-json\": \"true\"\n    \"log-format-upstream\": \"{\\\"bytes_sent\\\":\\\"$bytes_sent\\\",\\\"duration\\\":\\\"$request_time\\\",\\\"http_referrer\\\":\\\"$http_referer\\\",\\\"http_user_agent\\\":\\\"$http_user_agent\\\",\\\"method\\\":\\\"$request_method\\\",\\\"path\\\":\\\"$uri\\\",\\\"remote_addr\\\":\\\"$remote_addr\\\",\\\"remote_user\\\":\\\"$remote_user\\\",\\\"request_id\\\":\\\"$req_id\\\",\\\"request_length\\\":\\\"$request_length\\\",\\\"request_proto\\\":\\\"$server_protocol\\\",\\\"request_query\\\":\\\"$args\\\",\\\"request_time\\\":\\\"$request_time\\\",\\\"status\\\":\\\"$status\\\",\\\"time\\\":\\\"$time_iso8601\\\",\\\"upstream_addr\\\":\\\"$upstream_addr\\\",\\\"upstream_response_time\\\":\\\"$upstream_response_time\\\",\\\"upstream_status\\\":\\\"$upstream_status\\\",\\\"vhost\\\":\\\"$host\\\",\\\"x_forwarded_for\\\":\\\"$proxy_add_x_forwarded_for\\\"}\"\n    \"max-worker-connections\": \"65536\"\n    \"proxy-real-ip-cidr\": \"0.0.0.0/0\"\n    \"upstream-keepalive-connections\": \"50\"\n    \"upstream-keepalive-requests\": \"1000\"\n    \"upstream-keepalive-timeout\": \"60\"\n    \"use-forwarded-headers\": \"true\"\n    \"worker-processes\": \"auto\"\n  \"metrics\":\n    \"enabled\": true\n    \"serviceMonitor\":\n      \"enabled\": false\n  \"replicaCount\": 2\n  \"resources\":\n    \"limits\":\n      \"cpu\": \"200m\"\n      \"memory\": \"256Mi\"\n    \"requests\":\n      \"cpu\": \"100m\"\n      \"memory\": \"128Mi\"\n  \"service\":\n    \"annotations\":\n      \"service.beta.kubernetes.io/aws-load-balancer-backend-protocol\": \"tcp\"\n      \"service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled\": \"true\"\n      \"service.beta.kubernetes.io/aws-load-balancer-scheme\": \"internet-facing\"\n      \"service.beta.kubernetes.io/aws-load-balancer-type\": \"nlb\"\n    \"ports\":\n      \"http\": 80\n      \"https\": 443\n    \"targetPorts\":\n      \"http\": \"http\"\n      \"https\": \"https\"\n    \"type\": \"LoadBalancer\"\n\"defaultBackend\":\n  \"enabled\": true\n  \"image\":\n    \"repository\": \"registry.k8s.io/defaultbackend-amd64\"\n    \"tag\": \"1.5\"\n  \"resources\":\n    \"limits\":\n      \"cpu\": \"10m\"\n      \"memory\": \"20Mi\"\n    \"requests\":\n      \"cpu\": \"10m\"\n      \"memory\": \"20Mi\"\n"
